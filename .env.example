# Set before the production build. Use the final HTTPS URL, including any subpath.
# SITE_URL=https://your-domain.example
# BASE_PATH=/
# For subpath hosting, both must agree:
# SITE_URL=https://your-domain.example/reasons-within
# BASE_PATH=/reasons-within/

# Published Fillout link; never a Trello token or board email address.
VITE_FILLOUT_URL=https://forms.fillout.com/t/8GZ6z9esr9us
# Optional separately translated forms (free-plan alternative to paid translations):
# VITE_FILLOUT_URL_UK=
# VITE_FILLOUT_URL_FR=
# VITE_FILLOUT_URL_ES=
